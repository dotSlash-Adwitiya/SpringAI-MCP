{
  "mcpServers": {
    "filesystem": {
      "command": "/home/adwitiya/.nvm/versions/node/v24.21.0/bin/mcp-server-filesystem",
      "args": [
        "/media/adwitiya/dotSlash-Adwitiya1/mcp"
      ],
      "env": {
        "PATH": "/home/adwitiya/.nvm/versions/node/v24.21.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
      }
    },

    "github": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "-e",
        "GITHUB_HOST",
        "ghcr.io/github/github-mcp-server"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN" : "${GITHUB_PERSONAL_ACCES_TOKEN}",
        "GITHUB_HOST": "https://github.com/dotSlash-Adwitiya"
      }
    }

  }
}